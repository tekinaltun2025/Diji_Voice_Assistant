{
  "name": "@diji/agent",
  "version": "1.0.0",
  "description": "Diji LiveKit Agents pipeline",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "npm run build && node dist/index.js",
    "dev:text": "npm run build && DIJI_MODE=text node dist/index.js",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "start:text": "DIJI_MODE=text node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@diji/shared": "*",
    "dotenv": "^16.4.5",
    "livekit-server-sdk": "^1.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.43",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  }
}
