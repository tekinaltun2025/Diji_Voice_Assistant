# ==============================================================================
# Diji Voice Assistant — örnek yapılandırma
#
# Bu dosya SADECE bir şablondur. Kopyalayıp kendi değerlerinizle doldurun:
#
#   cp .env.example .env
#
# .env dosyası .gitignore ile DIŞLANMIŞTIR — sırlarınızı asla commit etmeyin.
#
# ÖNEMLİ — öncelik sırası:
#   1. Süreç ortamı (terminalde export, systemd, Electron spawn)
#   2. ~/.config/diji/env   (kalıcı kullanıcı ayarı — Ayarlar ekranı buraya yazar)
#   3. shared/src/config/default.ts içindeki gömülü varsayılan
#
# Yani .env dosyasındaki bir değer, terminalde zaten tanımlı bir değişkeni
# EZMEZ. Ayrıntı: docs/CONFIGURATION.md
# ==============================================================================


# ------------------------------------------------------------------ Çalışma modu
# microphone | text | both
DIJI_MODE=microphone

# Kontrol sunucusu portu (ana makine 127.0.0.1'e SABİTTİR, ağa açılmaz)
DIJI_CONTROL_PORT=8899

# Model dosyalarının kök dizini (STT / VAD / TTS / katalog)
DIJI_MODELS_DIR=$HOME/.diji/models

# error | warn | info | debug   (debug çok ayrıntılıdır)
LOG_LEVEL=info


# --------------------------------------------------------------------- Ses aygıtı
# 'default' → PipeWire/PulseAudio. plughw:... KULLANMAYIN: aygıtı tek başına
# ele geçirir ve diğer tüm uygulamaların mikrofonunu keser.
DIJI_AUDIO_INPUT_DEVICE=default
DIJI_AUDIO_OUTPUT_DEVICE=default

# Mikrofon "sessiz ortam" eşiği (RMS). Panelin idle/active ayrımı buna dayanır.
DIJI_AUDIO_SILENCE_THRESHOLD=0.002


# --------------------------------------------------------- STT (Whisper, yerel)
# Kalıcı model seçimi: belirtilen ön ek, öncelik listesinin BAŞINA alınır.
# Diskte o model yoksa sessizce bir alt modele düşer (ajan yine açılır).
DIJI_STT_MODEL_PREFIX=small
DIJI_STT_MODEL=whisper-small

# Yedek listesi — diskte ilk BULUNAN model yüklenir.
DIJI_STT_MODEL_PRIORITY=medium,small,base,tiny

DIJI_STT_LANGUAGE=tr
DIJI_STT_THREADS=2

# Ön işleme: DC çıkarma → high-pass → sessizlik kırpma → gürültü kapısı → AGC
DIJI_STT_PREPROCESS=true
DIJI_STT_HIGHPASS_HZ=80
DIJI_STT_TRIM_THRESHOLD=0.006
DIJI_STT_TARGET_RMS=0.06
DIJI_STT_MAX_GAIN_DB=18
DIJI_STT_NOISE_GATE_RMS=0.0025

# Son işleme: halüsinasyon ayıklama + sözlük + boşluk düzeltme
DIJI_STT_POSTPROCESS=true
DIJI_STT_FUZZY_DISTANCE=1


# --------------------------------------------------------------------- VAD
DIJI_VAD_THRESHOLD=0.5
DIJI_VAD_MIN_SILENCE=0.6
DIJI_VAD_MIN_SPEECH=0.25


# --------------------------------------------------------------------- TTS
# 1 / 0 — seslendirmeyi tamamen kapatır (çalışma zamanında da değiştirilebilir)
DIJI_TTS_ENABLED=1

# drifting-tts (birincil, Python köprüsü, ~60-70 sn yükleme)
# sherpa-vits (yedek, saf onnx, ~1-3 sn yükleme)
DIJI_TTS_PROVIDER=sherpa-vits

# YALNIZCA sherpa-vits için model dizini adı.
# (DIJI_TTS_MODEL her iki sağlayıcıda okunur; drifting kimliğinin sherpa'ya
#  sızmasını önlemek için ayrı anahtar.)
DIJI_TTS_VITS_MODEL=vits-piper-tr_TR-fettah-medium

# drifting-tts ayarları (yalnızca DIJI_TTS_PROVIDER=drifting-tts iken)
# DIJI_TTS_MODEL=Vyvo/drifting-tts-tr
# DIJI_TTS_PYTHON=python3
# DIJI_TTS_BRIDGE=./scripts/drifting_tts_bridge.py

DIJI_TTS_VOICE=fettah
DIJI_TTS_SPEED=1.0
DIJI_TTS_SAMPLE_RATE=48000


# --------------------------------------------------------------------- LLM
# OpenAI uyumlu YEREL sunucu (llama.cpp, Ollama, vLLM, LM Studio …)
DIJI_LLM_BASE_URL=http://127.0.0.1:8000/v1
DIJI_LLM_MODEL=agent
DIJI_LLM_API_KEY=sk-local

DIJI_LLM_TEMPERATURE=0.7
DIJI_LLM_MAX_TOKENS=1024
DIJI_LLM_TIMEOUT_MS=120000

# Reasoning modelleri için ayrılan token payı.
# 0 → reasoning modelinde BOŞ yanıt alırsınız.
# 1024 → dengeli (varsayılan). 2048 → güvenli üst sınır.
# Reasoning kullanmayan modeller (ör. coder) için 0 uygun olabilir.
DIJI_LLM_REASONING_RESERVE=1024


# --------------------------------------------------------------------- MCP
DIJI_MCP_ENABLED=true

# Silme işlemleri VARSAYILAN OLARAK KAPALIDIR.
# true yaparsanız bile her silme çağrısında sesli onay istenir.
DIJI_ALLOW_DELETE=false

# OAuth2 token'ları burada saklanır. .gitignore dışlar — commit etmeyin.
TOKEN_STORAGE_PATH=./tokens

# !!! ÜRETİMDE MUTLAKA DEĞİŞTİRİN !!!
# Varsayılan parola ile şifrelenmiş token, dosyayı ele geçiren herkes
# tarafından çözülebilir.
# ENCRYPTION_PASSWORD=guclu-bir-parola-yazin


# ------------------------------------------------------- MCP OAuth2 (isteğe bağlı)
# Yalnızca ilgili MCP sunucusunu kullanacaksanız doldurun.
# Yönlendirme URI'si varsayılanı: http://localhost:3000/auth/<sunucu>/callback

# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=http://localhost:3000/auth/gmail/callback

# CALENDAR_CLIENT_ID=
# CALENDAR_CLIENT_SECRET=
# CALENDAR_REDIRECT_URI=http://localhost:3000/auth/calendar/callback

# DRIVE_CLIENT_ID=
# DRIVE_CLIENT_SECRET=
# DRIVE_REDIRECT_URI=http://localhost:3000/auth/drive/callback

# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=http://localhost:3000/auth/notion/callback

# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=http://localhost:3000/auth/slack/callback


# ---------------------------------------------------------- Araştırma modülü
DIJI_RESEARCH_TEMPERATURE=0.7
DIJI_RESEARCH_MAX_TOKENS=4096
DIJI_RESEARCH_TIMEOUT_MS=300000
DIJI_RESEARCH_MAX_STEPS=10


# ------------------------------------------------------------- Electron arayüzü
# Proje kökü ipucu (paketlenmiş uygulamada ajanı bulmak için)
# DIJI_ROOT=/yol/Diji_Voice_Assistant

# Node yorumlayıcısı (PATH'te yoksa)
# DIJI_NODE_BIN=/usr/bin/node

# Sandbox VARSAYILAN OLARAK AÇIKTIR. 0 vermek güvenliği azaltır.
# Yalnızca kullanıcı ad alanı kısıtı nedeniyle Chromium hiç açılamıyorsa 0 yapın.
# DIJI_ELECTRON_SANDBOX=1


# ---------------------------------------------------------------------------
# LiveKit — mevcut boru hattı KULLANMIYOR. Şemada duruyor, boş bırakın.
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
